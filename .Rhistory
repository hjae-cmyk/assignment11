install.packages("renv")
renv::init()
renv::snapshot()
data(mtcars)
summary(mtcars)
ggplot(mtcars, aes(x = wt, y = mpg)) +
geom_point() +
labs(title = "Car Weight vs MPG")
ggplot2(mtcars, aes(x = wt, y = mpg)) +
geom_point() +
labs(title = "Car Weight vs MPG")
library(dplyr)
library(ggplot2)
ggplot2(mtcars, aes(x = wt, y = mpg)) +
geom_point() +
labs(title = "Car Weight vs MPG")
ggplot(mtcars, aes(x = wt, y = mpg)) +
geom_point() +
labs(title = "Car Weight vs MPG")
getwd()
